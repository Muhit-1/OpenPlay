# Copy to .env and fill in. .env is gitignored — never commit real keys.

# TMDB API key (server-side only, never exposed to the browser).
# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Firebase — these VITE_ vars are bundled into the client by design.
# Lock the project down with Firestore security rules, not by hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# Optional: comma-separated host allowlist for /api/proxy.
# Leave empty to allow any host (fine for local/LAN use; set it for public deploys).
# Example: ALLOWED_PROXY_HOSTS=172.16.50.7,172.16.50.12,172.16.50.14
ALLOWED_PROXY_HOSTS=
