# Copy to .env and fill in. .env is gitignored — never commit real keys.

# TMDB API key (server-side only, never exposed to the browser).
# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Firebase — these VITE_ vars are bundled into the client by design.
# Lock the project down with the rules in firestore.rules, not by hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# Optional on a LAN install, REQUIRED on a hosted (Vercel) deployment:
# comma-separated hosts /api/proxy may reach. When set, anything else is refused.
# Example: ALLOWED_PROXY_HOSTS=172.16.50.7,172.16.50.12,172.16.50.14
ALLOWED_PROXY_HOSTS=

# Optional: origins allowed to call the API cross-origin (default: none).
ALLOWED_ORIGINS=

# Optional: requests per minute per client. Default: unlimited for a LAN install,
# 600 on Vercel.
RATE_LIMIT_PER_MIN=

# Optional: port / bind address for `npm start` (default 8080 on 0.0.0.0).
PORT=
HOST=
